# Public project settings: these values are exposed to the browser by design.
# Use the project's URL and publishable key; never put a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_your_publishable_key

# Never add SUPABASE_SERVICE_ROLE_KEY to this client-authentication setup.
# User sessions and Row Level Security should authorize normal application requests.
